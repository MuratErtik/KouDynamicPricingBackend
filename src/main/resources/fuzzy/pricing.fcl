FUNCTION_BLOCK DynamicPricing

VAR_INPUT
    daysToDeparture : REAL;
    occupancyRate   : REAL;
    dayScore        : REAL;
    timeScore       : REAL;
END_VAR

VAR_OUTPUT
    priceFactor : REAL;
END_VAR

FUZZIFY daysToDeparture
    TERM veryShort := (0,1) (1,1) (3,0);
    TERM short     := (1,0) (7,1) (15,0);
    TERM medium    := (10,0) (30,1) (60,0);
    TERM earlyLong := (45,0) (75,1) (105,0);
    TERM farLong   := (90,0) (135,1) (180,1);
END_FUZZIFY

FUZZIFY occupancyRate
    TERM low      := (0.0,1) (0.2,1) (0.45,0);
    TERM medium   := (0.35,0) (0.55,1) (0.75,0);
    TERM high     := (0.65,0) (0.80,1) (0.92,0);
    TERM critical := (0.88,0) (0.95,1) (1.0,1);
END_FUZZIFY

FUZZIFY dayScore
    TERM low_demand    := (0.0,1) (0.20,1) (0.35,0);
    TERM medium_demand := (0.30,0) (0.55,1) (0.75,0);
    TERM high_demand   := (0.70,0) (0.85,1) (1.0,1);
END_FUZZIFY

FUZZIFY timeScore
    TERM deep_night := (0.0,1) (0.05,1) (0.12,0);
    TERM late_night := (0.10,0) (0.15,1) (0.25,0);
    TERM evening    := (0.22,0) (0.35,1) (0.50,0);
    TERM business   := (0.48,0) (0.60,1) (0.72,0);
    TERM near_peak  := (0.70,0) (0.85,1) (0.92,0);
    TERM prime_peak := (0.90,0) (0.95,1) (1.0,1);
END_FUZZIFY

DEFUZZIFY priceFactor
    TERM veryLow  := (0.70,0) (0.80,1) (0.88,0);
    TERM low      := (0.85,0) (0.92,1) (0.98,0);
    TERM moderate := (0.95,0) (1.00,1) (1.08,0);
    TERM high     := (1.05,0) (1.20,1) (1.35,0);
    TERM veryHigh := (1.30,0) (1.55,1) (1.80,0);
    TERM extreme  := (1.70,0) (2.20,1) (3.00,1);

    METHOD : COG;
    DEFAULT := 1.0;
END_DEFUZZIFY

RULEBLOCK PricingRules
    AND : MIN;
    ACT : MIN;
    ACCU : MAX;

    // ==========================================
    // PRIORITY 1: TIME-BASED
    // ==========================================

    RULE 1: IF timeScore IS deep_night
            THEN priceFactor IS veryLow;

    RULE 2: IF timeScore IS deep_night AND occupancyRate IS medium
            THEN priceFactor IS veryLow;

    RULE 3: IF timeScore IS deep_night AND occupancyRate IS high
            THEN priceFactor IS low;

    RULE 4: IF timeScore IS late_night
            THEN priceFactor IS veryLow;

    RULE 5: IF timeScore IS late_night AND occupancyRate IS medium
            THEN priceFactor IS low;

    RULE 6: IF timeScore IS late_night AND occupancyRate IS high
            THEN priceFactor IS moderate;

    RULE 7: IF timeScore IS evening
            THEN priceFactor IS low;

    RULE 8: IF timeScore IS evening AND occupancyRate IS high
            THEN priceFactor IS moderate;

    RULE 9: IF timeScore IS business
            THEN priceFactor IS moderate;

    RULE 10: IF timeScore IS business AND occupancyRate IS high
             THEN priceFactor IS high;

    RULE 11: IF timeScore IS near_peak
             THEN priceFactor IS high;

    RULE 12: IF timeScore IS near_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    RULE 13: IF timeScore IS prime_peak
             THEN priceFactor IS high;

    RULE 14: IF timeScore IS prime_peak AND occupancyRate IS medium
             THEN priceFactor IS veryHigh;

    RULE 15: IF timeScore IS prime_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    // ==========================================
    // PRIORITY 2: DAY-BASED
    // ==========================================

    RULE 16: IF dayScore IS low_demand
             THEN priceFactor IS low;

    RULE 17: IF dayScore IS low_demand AND occupancyRate IS medium
             THEN priceFactor IS low;

    RULE 18: IF dayScore IS low_demand AND occupancyRate IS high
             THEN priceFactor IS moderate;

    RULE 19: IF dayScore IS medium_demand
             THEN priceFactor IS moderate;

    RULE 20: IF dayScore IS medium_demand AND occupancyRate IS high
             THEN priceFactor IS high;

    RULE 21: IF dayScore IS high_demand
             THEN priceFactor IS high;

    RULE 22: IF dayScore IS high_demand AND occupancyRate IS medium
             THEN priceFactor IS veryHigh;

    RULE 23: IF dayScore IS high_demand AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    RULE 24: IF dayScore IS high_demand AND timeScore IS prime_peak
             THEN priceFactor IS extreme;

    // ==========================================
    // PRIORITY 3: DAYS TO DEPARTURE (ÇOK GÜÇLÜ!)
    // ==========================================

    // SON DAKİKA (0-3 gün) - EXTREME ARTIŞLAR
    RULE 25: IF daysToDeparture IS veryShort AND occupancyRate IS critical
             THEN priceFactor IS extreme;

    RULE 26: IF daysToDeparture IS veryShort AND occupancyRate IS high
             THEN priceFactor IS extreme;

    RULE 27: IF daysToDeparture IS veryShort AND occupancyRate IS medium
             THEN priceFactor IS veryHigh;

    RULE 28: IF daysToDeparture IS veryShort AND occupancyRate IS low
             THEN priceFactor IS veryHigh;

    // KISA VADE (1-15 gün) - YÜKSEK ARTIŞLAR
    RULE 29: IF daysToDeparture IS short AND occupancyRate IS critical
             THEN priceFactor IS extreme;

    RULE 30: IF daysToDeparture IS short AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    RULE 31: IF daysToDeparture IS short AND occupancyRate IS medium
             THEN priceFactor IS high;

    RULE 32: IF daysToDeparture IS short AND occupancyRate IS low
             THEN priceFactor IS moderate;

    // ORTA VADE (10-60 gün) - ORTA ARTIŞLAR
    RULE 33: IF daysToDeparture IS medium AND occupancyRate IS critical
             THEN priceFactor IS veryHigh;

    RULE 34: IF daysToDeparture IS medium AND occupancyRate IS high
             THEN priceFactor IS high;

    RULE 35: IF daysToDeparture IS medium AND occupancyRate IS medium
             THEN priceFactor IS moderate;

    RULE 36: IF daysToDeparture IS medium AND occupancyRate IS low
             THEN priceFactor IS low;

    // ERKEN (45-105 gün) - HAFIF İNDİRİM
    RULE 37: IF daysToDeparture IS earlyLong AND occupancyRate IS high
             THEN priceFactor IS moderate;

    RULE 38: IF daysToDeparture IS earlyLong
             THEN priceFactor IS low;

    // ÇOK ERKEN (90-180 gün) - MAX İNDİRİM
    RULE 39: IF daysToDeparture IS farLong
             THEN priceFactor IS veryLow;

    // ==========================================
    // COMBO RULES (EXTREME DURUMLAR)
    // ==========================================

    RULE 40: IF dayScore IS high_demand AND timeScore IS prime_peak AND occupancyRate IS high
             THEN priceFactor IS extreme;

    RULE 41: IF dayScore IS high_demand AND timeScore IS prime_peak
             THEN priceFactor IS veryHigh;

    RULE 42: IF dayScore IS low_demand AND timeScore IS deep_night
             THEN priceFactor IS veryLow;

    RULE 43: IF dayScore IS low_demand AND timeScore IS late_night
             THEN priceFactor IS veryLow;

    RULE 44: IF daysToDeparture IS veryShort AND timeScore IS prime_peak
             THEN priceFactor IS extreme;

    RULE 45: IF dayScore IS high_demand AND timeScore IS near_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    RULE 46: IF dayScore IS low_demand AND timeScore IS evening
             THEN priceFactor IS low;

    RULE 47: IF dayScore IS medium_demand AND timeScore IS business
             THEN priceFactor IS moderate;

    RULE 48: IF dayScore IS medium_demand AND timeScore IS prime_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

END_RULEBLOCK

END_FUNCTION_BLOCK