FUNCTION_BLOCK DynamicPricing

VAR_INPUT
    daysToDeparture : REAL;
    occupancyRate   : REAL;
    dayScore        : REAL;
    timeScore       : REAL;
END_VAR

VAR_OUTPUT
    priceFactor : REAL;
END_VAR

FUZZIFY daysToDeparture
    TERM veryShort := (0,1) (1,1) (3,0);
    TERM short     := (1,0) (7,1) (15,0);
    TERM medium    := (10,0) (30,1) (60,0);
    TERM earlyLong := (45,0) (75,1) (105,0);
    TERM farLong   := (90,0) (135,1) (180,1);
END_FUZZIFY

FUZZIFY occupancyRate
    TERM low      := (0.0,1) (0.2,1) (0.45,0);
    TERM medium   := (0.35,0) (0.55,1) (0.75,0);
    TERM high     := (0.65,0) (0.80,1) (0.92,0);
    TERM critical := (0.88,0) (0.95,1) (1.0,1);
END_FUZZIFY

FUZZIFY dayScore
    TERM low_demand    := (0.0,1) (0.20,1) (0.35,0);    // Daha dar (0.20 için %100)
    TERM medium_demand := (0.30,0) (0.55,1) (0.75,0);   // Orta alanda
    TERM high_demand   := (0.70,0) (0.85,1) (1.0,1);    // Daha yüksek başlangıç
END_FUZZIFY

FUZZIFY timeScore
    TERM deep_night := (0.0,1) (0.05,1) (0.12,0);
    TERM late_night := (0.10,0) (0.15,1) (0.25,0);
    TERM evening    := (0.22,0) (0.35,1) (0.50,0);
    TERM business   := (0.48,0) (0.60,1) (0.72,0);
    TERM near_peak  := (0.70,0) (0.85,1) (0.92,0);
    TERM prime_peak := (0.90,0) (0.95,1) (1.0,1);
END_FUZZIFY

DEFUZZIFY priceFactor
    TERM veryLow  := (0.85,0) (0.90,1) (0.94,0);   // 0.85-0.94 (15-6% indirim)
    TERM low      := (0.90,0) (0.94,1) (0.98,0);   // 0.90-0.98 (10-2% indirim)
    TERM moderate := (0.95,0) (1.00,1) (1.05,0);   // 0.95-1.05 (±5%)
    TERM high     := (1.02,0) (1.08,1) (1.14,0);   // 1.02-1.14 (2-14% artış)
    TERM veryHigh := (1.10,0) (1.18,1) (1.26,0);   // 1.10-1.26 (10-26% artış)
    TERM extreme  := (1.20,0) (1.32,1) (1.50,1);   // 1.20-1.50 (20-50% artış)

    METHOD : COG;
    DEFAULT := 1.0;
END_DEFUZZIFY

RULEBLOCK PricingRules
    AND : MIN;
    ACT : MIN;
    ACCU : MAX;

    // ==========================================
    // PRIORITY 1: TIME-BASED (Daha agresif)
    // ==========================================

    // DEEP NIGHT (02-05) - Maksimum indirim
    RULE 1: IF timeScore IS deep_night
            THEN priceFactor IS veryLow;

    RULE 2: IF timeScore IS deep_night AND occupancyRate IS medium
            THEN priceFactor IS veryLow;

    RULE 3: IF timeScore IS deep_night AND occupancyRate IS high
            THEN priceFactor IS low;

    // LATE NIGHT (23-01) - Ciddi indirim
    RULE 4: IF timeScore IS late_night
            THEN priceFactor IS veryLow;

    RULE 5: IF timeScore IS late_night AND occupancyRate IS medium
            THEN priceFactor IS low;

    RULE 6: IF timeScore IS late_night AND occupancyRate IS high
            THEN priceFactor IS moderate;

    // EVENING (21-22) - Indirim
    RULE 7: IF timeScore IS evening
            THEN priceFactor IS low;

    RULE 8: IF timeScore IS evening AND occupancyRate IS high
            THEN priceFactor IS moderate;

    // BUSINESS (11-15) - Normal
    RULE 9: IF timeScore IS business
            THEN priceFactor IS moderate;

    RULE 10: IF timeScore IS business AND occupancyRate IS high
             THEN priceFactor IS high;

    // NEAR PEAK (06, 10, 16, 20) - Yüksek
    RULE 11: IF timeScore IS near_peak
             THEN priceFactor IS high;

    RULE 12: IF timeScore IS near_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    // PRIME PEAK (07-09, 17-19) - Maksimum
    RULE 13: IF timeScore IS prime_peak
             THEN priceFactor IS high;

    RULE 14: IF timeScore IS prime_peak AND occupancyRate IS medium
             THEN priceFactor IS veryHigh;

    RULE 15: IF timeScore IS prime_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    // ==========================================
    // PRIORITY 2: DAY-BASED (Daha agresif)
    // ==========================================

    // LOW DEMAND DAYS (Salı, Çarşamba) - Ciddi indirim
    RULE 16: IF dayScore IS low_demand
             THEN priceFactor IS low;

    RULE 17: IF dayScore IS low_demand AND occupancyRate IS medium
             THEN priceFactor IS low;

    RULE 18: IF dayScore IS low_demand AND occupancyRate IS high
             THEN priceFactor IS moderate;

    // MEDIUM DEMAND DAYS (Pazartesi, Perşembe, Cumartesi) - Normal
    RULE 19: IF dayScore IS medium_demand
             THEN priceFactor IS moderate;

    RULE 20: IF dayScore IS medium_demand AND occupancyRate IS high
             THEN priceFactor IS high;

    // HIGH DEMAND DAYS (Cuma, Pazar) - Premium
    RULE 21: IF dayScore IS high_demand
             THEN priceFactor IS high;

    RULE 22: IF dayScore IS high_demand AND occupancyRate IS medium
             THEN priceFactor IS veryHigh;

    RULE 23: IF dayScore IS high_demand AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    RULE 24: IF dayScore IS high_demand AND timeScore IS prime_peak
             THEN priceFactor IS extreme;

    // [GERİ KALAN 21 KURALI AYNI BIRAKIN: RULE 25-45]

    // ==========================================
    // PRIORITY 3: DAYS TO DEPARTURE
    // ==========================================

    RULE 25: IF daysToDeparture IS veryShort AND occupancyRate IS critical
             THEN priceFactor IS extreme;

    RULE 26: IF daysToDeparture IS veryShort AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    RULE 27: IF daysToDeparture IS veryShort AND occupancyRate IS medium
             THEN priceFactor IS high;

    RULE 28: IF daysToDeparture IS short AND occupancyRate IS critical
             THEN priceFactor IS extreme;

    RULE 29: IF daysToDeparture IS short AND occupancyRate IS high
             THEN priceFactor IS high;

    RULE 30: IF daysToDeparture IS short AND occupancyRate IS medium
             THEN priceFactor IS moderate;

    RULE 31: IF daysToDeparture IS medium AND occupancyRate IS critical
             THEN priceFactor IS veryHigh;

    RULE 32: IF daysToDeparture IS medium AND occupancyRate IS high
             THEN priceFactor IS high;

    RULE 33: IF daysToDeparture IS medium AND occupancyRate IS medium
             THEN priceFactor IS moderate;

    RULE 34: IF daysToDeparture IS earlyLong
             THEN priceFactor IS low;

    RULE 35: IF daysToDeparture IS farLong
             THEN priceFactor IS veryLow;

    // ==========================================
    // COMBO RULES: Özel Durumlar
    // ==========================================

    // En pahalı: Cuma/Pazar + Peak + Yüksek doluluk
    RULE 36: IF dayScore IS high_demand AND timeScore IS prime_peak AND occupancyRate IS high
             THEN priceFactor IS extreme;

    RULE 37: IF dayScore IS high_demand AND timeScore IS prime_peak
             THEN priceFactor IS veryHigh;

    // En ucuz: Salı/Çarşamba + Gece
    RULE 38: IF dayScore IS low_demand AND timeScore IS deep_night
             THEN priceFactor IS veryLow;

    RULE 39: IF dayScore IS low_demand AND timeScore IS late_night
             THEN priceFactor IS veryLow;

    // Son dakika + gece = moderate indirim
    RULE 40: IF daysToDeparture IS veryShort AND timeScore IS deep_night
             THEN priceFactor IS moderate;

    // Son dakika + peak = extra pahalı
    RULE 41: IF daysToDeparture IS veryShort AND timeScore IS prime_peak
             THEN priceFactor IS veryHigh;

    // Hafta sonu + peak kombinasyonu
    RULE 42: IF dayScore IS high_demand AND timeScore IS near_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

    // Hafta içi + gece kombinasyonu
    RULE 43: IF dayScore IS low_demand AND timeScore IS evening
             THEN priceFactor IS low;

    // Orta gün + business saat
    RULE 44: IF dayScore IS medium_demand AND timeScore IS business
             THEN priceFactor IS moderate;

    // Pazartesi sabahı business flight
    RULE 45: IF dayScore IS medium_demand AND timeScore IS prime_peak AND occupancyRate IS high
             THEN priceFactor IS veryHigh;

END_RULEBLOCK

END_FUNCTION_BLOCK